{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Streaks",
  "version": "0.3.1",
  "identifier": "local.tiktokstreaks.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TikTok Streaks",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MaDi75",
    "copyright": "© 2026 MaDi75 — https://github.com/MaDi75/tiktok-streaks",
    "homepage": "https://github.com/MaDi75/tiktok-streaks",
    "shortDescription": "Не теряй серии (огоньки) в сообщениях TikTok",
    "longDescription": "TikTok Streaks — помощник, который сам отправляет сообщения и следит, чтобы ваши серии (огоньки) в личных сообщениях TikTok не сгорели. Неофициальный проект. © 2026 MaDi75.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
