{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Streaks",
  "version": "0.2.0",
  "identifier": "local.tiktokstreaks.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TikTok Streaks",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
